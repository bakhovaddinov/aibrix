kubectl label deployment qwen257 model.aibrix.ai/name=qwen257 model.aibrix.ai/port="8008" model.aibrix.ai/min_replicas="1" -n default
kubectl patch podautoscaler qwen257-autoscaler -n default --type='merge' -p '{"spec":{"minReplicas":0}}'
kubectl set env deployment/aibrix-gateway-plugins -n aibrix-system AIBRIX_GPU_OPTIMIZER_TRACING_FLAG="true"
